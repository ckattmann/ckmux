    "cli.vm.network.listsInactive": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "(the lists below take effect only in allowlist mode)"
          }
        }
      }
    },
    "cli.vm.network.usage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Usage:\n  cmux vm network <id>                                   Show the machine's outbound policy.\n  cmux vm network <id> set --mode <full|allowlist|none> [--dns <on|off>]\n  cmux vm network <id> set --policy <json>               Replace the whole policy.\n  cmux vm network <id> add-domain <domain>...\n  cmux vm network <id> remove-domain <domain>...\n  cmux vm network <id> add-range <cidr> [--port <n>] [--protocol <tcp|udp>] [--note <text>]\n  cmux vm network <id> remove-range <cidr> [--port <n>] [--protocol <tcp|udp>]\n  cmux vm network <id> preset <add|remove> <preset-id>...\n\nModes: full reaches any public address; allowlist reaches only the listed\ndomains and ranges; none reaches nothing. cmux's own hosts stay reachable\nin every mode. Domains are exact HTTPS host names (no wildcards). A range\nwith --port and no --protocol means TCP. Open DNS (--dns on) is itself an\noutbound channel. Changes apply live to a running machine, with no restart.\n`cmux vm network <id>` lists the preset ids. Add --json for the structured result."
          }
        }
      }
    },
    "cli.vm.new.agentUpdatesFlag": {
      "extractionState": "manual",
      "localizations": {
        "en": {
