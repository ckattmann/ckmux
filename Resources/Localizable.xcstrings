    "cli.help.wait-for": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Usage: cmux wait-for [-S|--signal|-L|-U] <name> [--timeout <seconds>]\n\nWait for or signal a named synchronization token, or lock/unlock it.\n\nFlags:\n  -S, --signal           Signal the token instead of waiting\n  -L                     Take the token's lock, waiting up to the timeout\n  -U                     Release the token's lock\n  --timeout <seconds>    Wait timeout (default: 30)"
          }
        }
      }
    },
