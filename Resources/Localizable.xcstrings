    "settings.browser.externalPatterns.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applies to browser-page link clicks, terminal link clicks, and intercepted `open https://...` calls. One rule per line. Plain text matches any URL substring; regex-shaped rules and `*`/`?` wildcards are supported (for example: example.com, *example.com*, .*example\\.com.*). Regex rules containing `*` or `?` must use the `re:` prefix; legacy `.*`/`.+` rules remain supported."
          }
        }
      }
    },
    "settings.browser.hiddenWebViewDiscard": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Browser Memory Saver"
